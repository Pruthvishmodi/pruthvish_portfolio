DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/personal-portfolio
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Supabase Storage (S3-compatible) credentials
# These are read by payload.config.ts for the @payloadcms/storage-s3 plugin.
# Set these in your Vercel project environment variables as well.
S3_BUCKET=your-supabase-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY=your-supabase-s3-access-key
S3_SECRET_KEY=your-supabase-s3-secret-key
